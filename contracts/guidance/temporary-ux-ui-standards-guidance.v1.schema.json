{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ev4.local/contracts/guidance/temporary-ux-ui-standards-guidance.v1.schema.json",
  "title": "EV4 Temporary UX/UI Standards Guidance v1",
  "x-ev4-contract-id": "temporary-ux-ui-standards-guidance.v1",
  "x-ev4-contract-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "guidance_id",
    "revision",
    "lifecycle",
    "guidance_items",
    "conflict_handling",
    "authority_boundary",
    "boundary_claims"
  ],
  "properties": {
    "schema_version": {
      "const": "temporary-ux-ui-standards-guidance.v1"
    },
    "guidance_id": {
      "type": "string",
      "pattern": "^UXUI-GUIDANCE-[A-Z0-9][A-Z0-9._-]{2,63}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^r[0-9]{3}$"
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "issued_at",
        "review_by",
        "supersedes",
        "superseded_by"
      ],
      "properties": {
        "status": {
          "enum": [
            "draft",
            "active",
            "expired",
            "superseded"
          ]
        },
        "issued_at": {
          "type": "string",
          "format": "date"
        },
        "review_by": {
          "type": "string",
          "format": "date"
        },
        "supersedes": {
          "type": [
            "string",
            "null"
          ]
        },
        "superseded_by": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "guidance_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/guidanceItem"
      }
    },
    "conflict_handling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "precedence",
        "unresolved_conflict_effect",
        "guidance_may_override_higher_authority"
      ],
      "properties": {
        "precedence": {
          "const": [
            "repository_contracts_schemas_validators_stage_anchors",
            "kernel_decisions_and_project_gate_boundaries",
            "gated_project_specific_evidence",
            "temporary_ux_ui_guidance"
          ]
        },
        "unresolved_conflict_effect": {
          "const": "fail_closed_non_selectable"
        },
        "guidance_may_override_higher_authority": {
          "const": false
        }
      }
    },
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "usage_class",
        "repository_authority_created",
        "replaces_contracts_or_validators",
        "replaces_stage_anchors",
        "replaces_kernel_decisions",
        "replaces_project_gate_authority",
        "creates_project_specific_evidence",
        "may_establish_correctness"
      ],
      "properties": {
        "usage_class": {
          "const": "non_authoritative_decision_support"
        },
        "repository_authority_created": {
          "const": false
        },
        "replaces_contracts_or_validators": {
          "const": false
        },
        "replaces_stage_anchors": {
          "const": false
        },
        "replaces_kernel_decisions": {
          "const": false
        },
        "replaces_project_gate_authority": {
          "const": false
        },
        "creates_project_specific_evidence": {
          "const": false
        },
        "may_establish_correctness": {
          "const": false
        }
      }
    },
    "boundary_claims": {
      "$ref": "#/$defs/boundaryClaims"
    }
  },
  "$defs": {
    "guidanceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "statement",
        "strength",
        "provenance",
        "applicability",
        "exceptions",
        "conflicts",
        "universal_rule_claimed"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "pattern": "^UXUI-[A-Z0-9][A-Z0-9._-]{2,63}$"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "strength": {
          "enum": [
            "informative",
            "recommended",
            "conditional"
          ]
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_title",
            "source_owner",
            "source_url",
            "source_class",
            "retrieved_at",
            "version_scope"
          ],
          "properties": {
            "source_title": {
              "type": "string",
              "minLength": 1
            },
            "source_owner": {
              "type": "string",
              "minLength": 1
            },
            "source_url": {
              "type": "string",
              "format": "uri"
            },
            "source_class": {
              "enum": [
                "primary_standard",
                "official_documentation",
                "official_repository",
                "approved_internal_policy"
              ]
            },
            "retrieved_at": {
              "type": "string",
              "format": "date"
            },
            "version_scope": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "applicability": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "applies_when",
            "does_not_apply_when",
            "surfaces"
          ],
          "properties": {
            "applies_when": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "does_not_apply_when": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "surfaces": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "exceptions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/conflictDisposition"
          }
        },
        "universal_rule_claimed": {
          "const": false
        }
      }
    },
    "conflictDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conflict_id",
        "higher_authority_class",
        "higher_authority_reference",
        "status",
        "resolution_reference",
        "bounded_rationale"
      ],
      "properties": {
        "conflict_id": {
          "type": "string",
          "pattern": "^UXUI-CONFLICT-[A-Z0-9][A-Z0-9._-]{2,63}$"
        },
        "higher_authority_class": {
          "enum": [
            "repository_contract_schema_validator_stage_anchor",
            "kernel_decision",
            "project_gate_boundary",
            "gated_project_specific_evidence"
          ]
        },
        "higher_authority_reference": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "resolved",
            "unresolved"
          ]
        },
        "resolution_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "bounded_rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "resolved"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "resolution_reference": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "unresolved"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "resolution_reference": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "boundaryClaims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "submitted_evidence_created",
        "issue_8_mutated",
        "pilot_authorized",
        "production_ready",
        "release_ready",
        "live_render_validated",
        "export_json_validated",
        "accessibility_passed",
        "pixel_perfect",
        "responsive_correctness_validated"
      ],
      "properties": {
        "submitted_evidence_created": {
          "const": false
        },
        "issue_8_mutated": {
          "const": false
        },
        "pilot_authorized": {
          "const": false
        },
        "production_ready": {
          "const": false
        },
        "release_ready": {
          "const": false
        },
        "live_render_validated": {
          "const": false
        },
        "export_json_validated": {
          "const": false
        },
        "accessibility_passed": {
          "const": false
        },
        "pixel_perfect": {
          "const": false
        },
        "responsive_correctness_validated": {
          "const": false
        }
      }
    }
  }
}
